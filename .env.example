# Copy to .env.local (gitignored), then: ./scripts/create-llm-secret.sh
# NEVER commit real keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ENABLED=true

# Prometheus / Haystack — alert RPM answers use Slack metadata (current_value/threshold).
# Live PromQL requires in-cluster Prom API or token (NOT the Grafana SSO URL alone).
# PROMETHEUS_URL=https://metrics.haystack.es          # Grafana UI — SSO, no direct API
# PROMETHEUS_URL=http://prometheus.internal:9090       # in-cluster Prom API (preferred)
# PROMETHEUS_TOKEN=                                   # bearer token if your Prom supports it
# PROMETHEUS_INTERNAL=true                             # skip SSO guard for http:// URLs
# PROMQL_HOSTNAME_QUERY=sum(your_rpm_metric{hostname="{hostname}"})

# Staging only — allow restart/delete/scale with yes/no confirmation in Slack thread
K8S_MUTATIONS_ENABLED=true

# Slack — https://api.slack.com/apps → NOC handover bot (not the NOC-Automator alert poster)
SLACK_SIGNING_SECRET=          # Basic Information → Signing Secret
SLACK_BOT_TOKEN=              # OAuth & Permissions → Install App → Bot User OAuth Token (xoxb-)
SLACK_APP_TOKEN=              # Basic Information → Socket Mode → App-Level Token (xapp-)
SLACK_ALERT_CHANNEL_IDS=C0B7R75EQ8K
# Private channel: Bot scopes groups:history, groups:read + events app_mention, message.groups
SLACK_TRIGGER_MODE=mention    # mention = only when @bot in thread (recommended)
# Optional extra alert names (Kube* and CrashLoopBackOff etc. are handled automatically)
# K8S_ALERT_NAMES=MyCustomK8sAlert
# Master agent router (A2A server, same protocol as specialists) — slack uses MASTER_AGENT_URL
AGENT_URLS=http://prometheus-agent.a2a-ops.svc.cluster.local:8080,http://rds-agent.a2a-ops.svc.cluster.local:8081,http://kubernetes-agent.a2a-ops.svc.cluster.local:8082
MASTER_AGENT_URL=http://127.0.0.1:8095
# A2A_PORT=8095  # master-agent bind port (default 8095)
KUBERNETES_AGENT_URL=http://kubernetes-agent.a2a-ops.svc.cluster.local:8082

# Incoming Webhook (optional) — POST only, cannot receive @mentions
# SLACK_INCOMING_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# n8n → webhook API (primary path: @mention → n8n → POST /investigate)
# WEBHOOK_API_KEY=              # optional; n8n sends X-API-Key header
# WEBHOOK_PORT=8090
