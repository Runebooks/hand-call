# Copy to .env.local (gitignored), then: ./scripts/create-llm-secret.sh
# NEVER commit real keys.

# Cloudverse JWT (from developers.freshworks.com → AMP → View API Key):
# OPENAI_AUTH_MODE=cloudverse
# OPENAI_API_KEY=eyJ...
# CLOUDVERSE_BASE_URL=https://cloudverse.freshworkscorp.com/api/v1
# Or OpenAI platform key:
# OPENAI_API_KEY_SK=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Cloudverse model id from playground dropdown.
# Azure-GPT-4o-mini — fastest for tool-calling agents (~4-5s end-to-end).
# Azure-GPT-5.2-chat — slower but slightly better on complex multi-incident queries.
OPENAI_MODEL=Azure-GPT-4o-mini
OPENAI_MAX_TOKENS=16000
OPENAI_TEMPERATURE=0
OPENAI_REASONING_EFFORT=none
LLM_ENABLED=true

# Prometheus / Haystack (tenant fw-noc) — see docs/HAYSTACK_GRAFANA_MCP.md
# Direct Prom API (in-cluster, used by prometheus-agent today):
# PROMETHEUS_URL=http://vpce-.../api/prom
# PROMETHEUS_ORG_ID=fw-noc
# PROMETHEUS_TOKEN=                                    # FWSS from haystack--fw-noc--auth-token
# PROMETHEUS_INTERNAL=true
# PROMQL_HOSTNAME_QUERY=kube_pod_container_status_restarts_total{namespace="{namespace}",pod="{hostname}"}
#
# Haystack Grafana MCP (Cursor IDE — VPN + gcloud JWT):
#   ./scripts/setup-haystack-mcp-cursor.sh  → .cursor/mcp.json
#   URL: https://mcp.haystack.es/grafana/fw-noc
#
# Haystack Grafana MCP (in-cluster VPC — FWSS token):
# HAYSTACK_MCP_URL=http://o11y.int.haystack.es/mcp
# HAYSTACK_MCP_TENANT=fw-noc
# PROMETHEUS_QUERY_BACKEND=direct   # direct | mcp | auto (auto tries MCP, falls back to /api/prom)

# Staging only — allow restart/delete/scale with yes/no confirmation in Slack thread
K8S_MUTATIONS_ENABLED=true

# kubernetes-agent brain: mcp = LLM tool-calling over the in-process MCP server
# (falls back to a JSON planner when the gateway lacks tool calling, then to
# heuristics when the LLM is disabled). Set legacy to use the old intent path.
K8S_AGENT_MODE=mcp            # mcp | legacy
K8S_MCP_MAX_STEPS=5           # max LLM<->tool round trips per query

# Slack — https://api.slack.com/apps → NOC handover bot (not the NOC-Automator alert poster)
SLACK_SIGNING_SECRET=          # Basic Information → Signing Secret
SLACK_BOT_TOKEN=              # OAuth & Permissions → Install App → Bot User OAuth Token (xoxb-)
SLACK_APP_TOKEN=              # Basic Information → Socket Mode → App-Level Token (xapp-)
SLACK_ALERT_CHANNEL_IDS=C0B7R75EQ8K
# Private channel: Bot scopes groups:history, groups:read + events app_mention, message.groups
SLACK_TRIGGER_MODE=mention    # mention = only when @bot in thread (recommended)
# Optional extra alert names (Kube* and CrashLoopBackOff etc. are handled automatically)
# K8S_ALERT_NAMES=MyCustomK8sAlert
# Master agent router (A2A server, same protocol as specialists) — slack uses MASTER_AGENT_URL
AGENT_URLS=http://prometheus-agent.a2a-ops.svc.cluster.local:8080,http://rds-agent.a2a-ops.svc.cluster.local:8081,http://kubernetes-agent.a2a-ops.svc.cluster.local:8082,http://freshservice-agent.a2a-ops.svc.cluster.local:8083
MASTER_AGENT_URL=http://127.0.0.1:8095
# A2A_PORT=8095  # master-agent bind port (default 8095)
KUBERNETES_AGENT_URL=http://kubernetes-agent.a2a-ops.svc.cluster.local:8082

# Incoming Webhook (optional) — POST only, cannot receive @mentions
# SLACK_INCOMING_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# n8n → webhook API (primary path: @mention → n8n → POST /investigate)
# WEBHOOK_API_KEY=              # optional; n8n sends X-API-Key header
# WEBHOOK_PORT=8090

# ── Freshservice NOC agent (port 8083) ────────────────────────────────────────
FRESHSERVICE_DOMAIN=freshworks.freshservice.com
FRESHSERVICE_API_KEY=            # Freshservice Admin → API Settings (keep secret!)
FRESHSERVICE_ANALYTICS_EXPORT_ID=  # UUID of scheduled Analytics export (for hourly sync)
FRESHSTATUS_ACCOUNT_ID=65        # Freshworks public Freshstatus account id
# Optional legacy MySQL for n8n incident data (Outages_data, MIM_Ticket_id, etc.)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# PostgreSQL fw-noc RDS — 6-month MIM_Store fallback cache (used when Freshservice API rate-limits)
PGHOST=          # fw-noc.clyoag7kp3ki.us-east-1.rds.amazonaws.com (must be reachable from a2a-ops cluster)
PGPORT=5432
PGDATABASE=fw-noc
PGUSER=dbuser
PGPASSWORD=
PGSSLMODE=require   # require | verify-full (verify-full needs the RDS global-bundle.pem)
FW_OUTAGE_SLACK_CHANNEL_ID=      # C012T9FG8NA — fw-outage channel id (bot must be a member; needs SLACK_BOT_TOKEN)
FRESHSERVICE_AGENT_MODE=mcp
FRESHSERVICE_MCP_MAX_STEPS=5
# Latency tuning (freshservice-agent)
FRESHSERVICE_FAST_PATH=true          # skip LLM for outage / MI-ID / Freshstatus questions
FRESHSERVICE_CACHE_ENABLED=true      # in-process TTL cache (no Redis required)
FRESHSERVICE_PG_CACHE_FIRST=true     # read MIM_Store before Freshservice API when cached
FRESHSERVICE_PIR_CACHE_TTL=3600      # seconds — repeat PIR lookups
FRESHSERVICE_FRESHSTATUS_CACHE_TTL=90
FRESHSERVICE_TOOL_CACHE_TTL=300
LLM_READ_TIMEOUT=30                  # fail faster on stalled Cloudverse calls (default 45)
